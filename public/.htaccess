# さくらインターネット用の設定（前段 nginx／後段 Apache）。
# 現行サイトが WordPress のパーマリンクで動いていることから、.htaccess は有効と確認済み。

# --- www ありでのアクセスを www なしへ集約 -----------------------------------
# これまで WordPress が転送していた（x-redirect-by: WordPress）。
# WordPress を消すとこの転送が無くなり、同じサイトが2つのURLで配られてしまうため、
# ここで引き継ぐ。http→https の転送はさくら側（nginx）が行うので記述しない。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.tomapufarm\.com$ [NC]
  RewriteRule ^(.*)$ https://tomapufarm.com/$1 [R=301,L]
</IfModule>

# --- 見つからないページ -------------------------------------------------------
ErrorDocument 404 /404.html

# --- WordPress 時代の入口は閉じる（存在しないので機械的なアクセスを止める）----
RedirectMatch 404 ^/wp-admin
RedirectMatch 404 ^/wp-login\.php
RedirectMatch 404 ^/wp-json
RedirectMatch 404 ^/wp-includes
RedirectMatch 404 ^/xmlrpc\.php

# --- ディレクトリの中身を一覧表示させない -----------------------------------
Options -Indexes

# --- 静的ファイルのキャッシュ -----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 30 days"
  ExpiresByType image/jpeg       "access plus 30 days"
  ExpiresByType image/svg+xml    "access plus 30 days"
  ExpiresByType video/mp4        "access plus 30 days"
  ExpiresByType application/pdf  "access plus 7 days"
  ExpiresByType text/css         "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# 旧URLからの転送は src/data/redirects.json に書く（転送用のHTMLが自動生成される）。
# ここには書かない。2か所に分かれると必ずずれる。
